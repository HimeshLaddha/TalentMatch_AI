# ---------------------------------------------------------------------------
# TalentMatch AI — Environment Variables
# Copy this file to .env and fill in real values before running the stack.
# NEVER commit .env — only .env.example is safe to commit.
# ---------------------------------------------------------------------------

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/talentmatch
QDRANT_HOST=localhost
QDRANT_PORT=6333
REDIS_URL=redis://localhost:6379
ADMIN_PASSWORD=change_me_before_deploy
GROQ_API_KEY=your_groq_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
JWT_SECRET=generate_a_long_random_string
