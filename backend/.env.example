# ---------------------------------------------------------------------------
# TalentMatch AI — Environment Variables
# Copy this file to .env and fill in real values before running the stack.
# NEVER commit .env — only .env.example is safe to commit.
# ---------------------------------------------------------------------------

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/talentmatch
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Redis — used as Celery result backend
REDIS_URL=redis://127.0.0.1:6379/0
# Use redis://redis:6379/0 when running inside Docker
ADMIN_PASSWORD=change_me_before_deploy
GROQ_API_KEY=your_groq_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=generate_a_random_string_of_at_least_32_chars
# RabbitMQ — used as Celery task broker
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
# Use amqp://talentmatch:password@rabbitmq:5672/ inside Docker
